module CustomFFmpeg [system] {
    header "include/libavcodec/avcodec.h"
    header "include/libavformat/avformat.h"
    header "include/libavutil/avutil.h"
    header "include/libavfilter/avfilter.h"
    
    link "avcodec"
    link "avformat"
    link "avutil"
    link "avfilter"
    
    export *
}